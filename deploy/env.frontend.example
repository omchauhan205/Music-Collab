# ============================================================
# Frontend environment variables
# Copy to frontend/.env and adjust for your environment.
# ============================================================

# Base URL of the backend REST API.
# Local development: keep as /api (uses the Vite dev proxy → http://localhost:8080).
# Production: full URL of the deployed backend, e.g.
#   VITE_API_BASE_URL=https://musiccollab-api.onrender.com/api
VITE_API_BASE_URL=/api
