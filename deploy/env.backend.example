# ============================================================
# Backend environment variables (production)
# Copy to a .env file or set these in your host's dashboard.
# ============================================================

# Spring profile
SPRING_PROFILES_ACTIVE=prod

# --- Database (PostgreSQL) ---
# Either provide a full JDBC URL...
# JDBC_DATABASE_URL=jdbc:postgresql://localhost:5432/musiccollab
# ...or the individual pieces below:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=musiccollab
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=5
DDL_AUTO=update

# --- Security ---
# Use a long, random value in production.
JWT_SECRET=change-me-in-production-please-use-a-long-random-secret-key-0123456789abcdef
JWT_EXPIRATION_MS=86400000

# --- CORS (comma-separated list of allowed frontend origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Storage ---
# local = filesystem, s3 = S3-compatible object storage
STORAGE_TYPE=local
STORAGE_LOCATION=/var/data/uploads
# When STORAGE_TYPE=s3:
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# --- Seed data (creates demo admin/musicians on first boot) ---
SEED_ENABLED=true
SEED_DEFAULT_PASSWORD=Password@123

# --- Server ---
SERVER_PORT=8080
